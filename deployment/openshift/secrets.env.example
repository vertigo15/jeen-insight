# ============================================================================
# Jeen Insights — SECRET runtime settings for air-gapped OpenShift
# ============================================================================
# Copy to secrets.env, fill in, then create the Secret the pods mount via
# envFrom (its name is referenced by values.openshift.yaml / manifests.yaml):
#
#   oc -n <namespace> create secret generic jeen-insights-secrets \
#       --from-env-file=secrets.env --dry-run=client -o yaml | oc apply -f -
#
# Format rules of --from-env-file: KEY=VALUE, one per line, no quotes, no
# spaces around '=', no trailing inline comments (they become part of the
# value). Keep this file out of git and delete it from the bastion once the
# Secret exists. Non-secret settings live in config.env.example.
# ============================================================================

# ── Metadata PostgreSQL (operational tables + curated metadata) ─────────────
# The Jeen Schema Modeler metadata database (initialised by its
# sql/init-metadata-db.sql). Insights adds its own insights_* tables there on
# first start, so the role needs CREATE on the schema plus read access to the
# metadata_* and admin_* tables.
METADATA_DB_HOST=postgres.example.internal
METADATA_DB_PORT=5432
METADATA_DB_NAME=jeen_data_metadata
METADATA_DB_USER=jeen_insights
METADATA_DB_PASSWORD=change-me

# ── Signing and encryption keys ─────────────────────────────────────────────
# Generate each one separately; never reuse a value across environments.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs the UI session cookie (JEEN_DEV_MODE=false refuses a weak/known value).
FLASK_SECRET_KEY=
# Signs the short-lived UI -> API tokens (default-deny on the API side).
INTERNAL_API_SECRET=
# Signs API -> ML-sandbox tokens. Must differ from INTERNAL_API_SECRET; the
# sandbox pod receives ONLY this key.
INTERNAL_ANALYTICS_SECRET=
# Key-encryption key for connector secrets and stored tokens (32 random bytes,
# base64). BACK IT UP: losing it makes stored connector secrets unrecoverable.
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
# One-time token that unlocks /setup to create the first admin account. Any
# long random string; you type it into the setup page once.
SETUP_BOOTSTRAP_TOKEN=

# ── Optional env-fallback LLM ───────────────────────────────────────────────
# Leave UNSET in an air-gapped deployment. The LLM (an on-prem OpenAI-compatible
# endpoint such as vLLM) is configured after first login in Settings -> AI
# Models and stored in the metadata DB. Only uncomment these when Azure OpenAI
# is reachable and you want a fallback model without touching the UI.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
