# ============================================================================
# Jeen Insights — NON-secret runtime settings for air-gapped OpenShift
# ============================================================================
# This is the reference list of what every pod receives besides the Secret.
#
# * Helm / manifests.yaml path (default): these values are rendered into the
#   per-component ConfigMaps from the bundled values.openshift.yaml. Change
#   them there (keep this file in sync as documentation), re-render, oc apply.
# * Hand-rolled Deployments: create one shared ConfigMap and reference it
#   with envFrom in every container; unused keys are ignored:
#     oc -n <namespace> create configmap jeen-insights-config \
#         --from-env-file=config.env --dry-run=client -o yaml | oc apply -f -
#
# Same format rules as secrets.env: KEY=VALUE, no quotes, comments on their
# own line. The full inventory with explanations is .env.example in the repo.
# ============================================================================

# ── Deployment mode: hardened ───────────────────────────────────────────────
# Refuses to start with weak/missing FLASK_SECRET_KEY, INTERNAL_API_SECRET or
# APP_ENCRYPTION_KEY, and only allows the sandbox ML runner.
JEEN_DEV_MODE=false
INTERNAL_AUTH_ENABLED=true
LOG_LEVEL=INFO
# json: one structured line per event, for the cluster log forwarder.
LOG_FORMAT=json
# Interface language for users who have not chosen one (en | he).
DEFAULT_LOCALE=en
# The root filesystem is read-only and the UID is arbitrary; /tmp is the only
# writable path (emptyDir).
HOME=/tmp
MPLCONFIGDIR=/tmp/mpl
# TLS to PostgreSQL. false only for a plain in-cluster instance.
METADATA_DB_SSL=true

# ── UI ──────────────────────────────────────────────────────────────────────
# In-cluster Service of the API (ClusterIP; never exposed by a Route).
API_BASE_URL=http://jeen-insights-api:8000
UI_PORT=8501
# Browser-facing URL = the OpenShift Route host (TLS terminated by the router).
PUBLIC_APP_URL=https://jeen-insights.apps.example.internal
SESSION_COOKIE_SECURE=true
# In-memory login rate limiting is correct for the single UI replica.
RATELIMIT_STORAGE_URI=memory://
# Entra ID SSO needs login.microsoftonline.com and is unusable air-gapped.
# Leave all AZURE_AD_* unset; users sign in with local accounts created by an
# admin after /setup.
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=

# ── Schema migrations ───────────────────────────────────────────────────────
# The metadata DB is shared with Schema Modeler. Render/apply/wait/log the
# chart's migration-only Job before workloads; API pods issue no DDL.
RUN_MIGRATIONS_ON_START=false
SCHEMA_BOOTSTRAP_ON_START=false

# ── ML skills (anomaly detection, forecasting, ...) in the sandbox pod ──────
ML_SKILLS_ENABLED=true
ANALYSIS_RUNNER=sandbox
ANALYSIS_SANDBOX_URL=http://jeen-insights-analytics:8100
ANALYSIS_SANDBOX_AUDIENCE=jeen-insights-analytics
ANALYSIS_TIMEOUT_SECONDS=30
ANALYSIS_MEMORY_MB=1024
ANALYSIS_MAX_SERIES_ROWS=1500
ANALYSIS_MAX_ENTITY_ROWS=50000
ANALYSIS_MAX_CONCURRENT=2
ANALYSIS_RUNS_PER_HOUR_PER_USER=60

# ── Features that require internet egress: keep off ─────────────────────────
OSM_MAPS_ENABLED=false
OSM_SEAMARKS_ENABLED=false
OSM_TERRAIN_ENABLED=false
OSM_GEOCODER_PROVIDER=

# ── LLM and query guardrails ────────────────────────────────────────────────
# On-prem models are usually slower than hosted ones; raise if answers time out.
LLM_TIMEOUT_SECONDS=120
LANGGRAPH_MAX_RETRIES=3
DB_STATEMENT_TIMEOUT_MS=30000
MAX_RESULT_ROWS=10000
CONVERSATION_CONTEXT_TURNS=5
CONVERSATION_PERSISTENCE_ENABLED=true
