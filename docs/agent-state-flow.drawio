              <mxPoint x="24" y="1532"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ── Arcs: fused_router ───────────────────────────────────────── -->
        <mxCell id="e06" value="route == capability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-fr" target="n-cap">
          <mxGeometry x="-0.5" y="-8" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="232"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e07" value="route == from_memory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-fr" target="n-mag">
          <mxGeometry x="-0.7" y="8" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="251"/>
              <mxPoint x="400" y="382"/>
            </Array>
