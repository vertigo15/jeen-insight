  <diagram id="1a3f0d2c-9b7e-4c61-8d55-2f4e6a7b8c90" name="2 - Nodes and arcs (detailed)">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ── Title, legend, notes ─────────────────────────────────────── -->
        <mxCell id="t-title" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Jeen Insights — main LangGraph&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;src/agent/langgraph_agent/graph.py · build_graph() · 27 nodes · 63 arcs · 20 conditional routers&lt;br&gt;Box = node name + what it does. Arc label = the routing condition (first match wins). Recursion limit 72 (longest legal path 59 supersteps), no checkpointer.&lt;br&gt;Memory: context_composer builds the turn ledger (question · SQL · answer · result shape · data availability); prior rows are recovered by reference (cache → snapshot → re-run) and computed over in the metadata Postgres as jsonb_to_recordset CTEs (no tables created), never pasted into prompts.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t-legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Purple = LLM node (router = small model, primary = large) · Green = DB / MCP · Gray = logic · Orange = validation / governance tools · Blue = ML runner&lt;br&gt;Black arc = main path · Dashed gray = short-circuit to response_formatter · Red = repair / feedback loop · Blue = ML skills branch · Blue dashed = re-entry from /api/analysis/run" style="text;html=1;strokeColor=#bbbbbb;fillColor=#fafafa;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="20" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t-notes" value="&lt;b&gt;Bounded cycles&lt;/b&gt;&lt;br&gt;• SQL repair: sql_generator → … → feedback_classifier → sql_generator; ends when retry_count &amp;gt; LANGGRAPH_MAX_RETRIES (3) → exhausted&lt;br&gt;• Catalog refresh: missing_table → catalog_lookup → filter_planner → filter_grounder → prompt_builder → sql_generator (same retry budget)&lt;br&gt;• Filter reground: 0 rows + (unverified literal or metadata-only resolution) → filter_grounder once, escalated: cache bypassed, metadata values re-confirmed on the source (empty_filter_diagnostics &amp;lt; 1; retry_count untouched)&lt;br&gt;• Empty-result recheck: suspicious 0 rows (aggregate / GROUP BY / INNER JOIN, no user filter) → empty_result_check → feedback_classifier → sql_generator once (empty_result_diagnostics &amp;lt; 1; retry_count untouched; LANGGRAPH_EMPTY_RECHECK)&lt;br&gt;The ML branch and the memory branch have no cycle: on_analysis_branch() / on_memory_branch() divert every failure straight to response_formatter (a memory table has no system prompt to retry with).&lt;br&gt;Every node is wrapped by _timed → progress events + one entry in the trace reducer (operator.add)." style="text;html=1;strokeColor=#bbbbbb;fillColor=#fafafa;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1590" width="360" height="240" as="geometry"/>
        </mxCell>

        <!-- ── ML branch container (behind the nodes) ───────────────────── -->
        <mxCell id="g-ml" value="ML skills branch — only when ml_skills_enabled. Deterministic SQL, no LLM repair loop; every failure goes straight to response_formatter." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f3f7fc;strokeColor=#6c8ebf;fontColor=#3b6ea5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1100" y="430" width="280" height="650" as="geometry"/>
        </mxCell>

        <!-- ── Terminals ────────────────────────────────────────────────── -->
        <mxCell id="n-start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="20" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n-end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="1780" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- ── Spine (centre column) ────────────────────────────────────── -->
        <mxCell id="n-cc" value="&lt;b&gt;context_composer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · build the turn ledger (T1…TN: question, SQL, answer, result shape, data status) from the last conversation_context_turns turns → memory_ledger, memory_telemetry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-fr" value="&lt;b&gt;fused_router&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (router) · greeting regex short-circuit; else one call over the ledger → route + prior_refs (T3) + history_query; capability / catalog_help cues; ML gate, keyword-cue upgrade, low-confidence clarify_route&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-cl" value="&lt;b&gt;catalog_lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DB / MCP · consume the pre-graph bundle once, else load (MCP → metadata-DB fallback); build known_tables / table_columns allowlists; fail closed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-fp" value="&lt;b&gt;filter_planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (router) ∥ reverse lookup of the question's words over captured values (metadata DB / MCP); runs on a predicate cue or a strong hit; hits shrink the catalog and become candidate_columns; binds ≤ 4 filters → filter_plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-fg" value="&lt;b&gt;filter_grounder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;normalise date/number operands; decide the column (planner ∩ eligible reachable hits; role word / remembered choice → resolve; single other column → retarget + disclose; competing roles → structured ask); ground the value: T0 cache → T1 metadata (complete+fresh → fuzzy fix) → T2 point probe → T3 DISTINCT (server-side timeout only) → T4 LIKE (candidates only) → resolved / unverified / ask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-pb" value="&lt;b&gt;prompt_builder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · render jeen_insights_system on the schema-linked bundle + runtime filter contract → system_prompt, structured_prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-sg" value="&lt;b&gt;sql_generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (primary) · tool-calling run_sql generation; error_context injected on retries → generated_sql or clarification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-sv" value="&lt;b&gt;sqlglot_validate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tool · parse; single read-only statement; schema qualifier; table/column allowlist; resolved filters kept → sqlglot_error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="800" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-dc" value="&lt;b&gt;dlp_check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tool · column-aware governed-pattern check (expands *), raw-text fallback → dlp_blocked, governance_error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="900" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-eq" value="&lt;b&gt;execute_query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DB · read-only SqlRunner with limit / max_result_rows / statement_timeout → query_result, exec_error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="1000" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-efc" value="&lt;b&gt;empty_filter_result_check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · 0 rows + (unverified text filter or metadata-only resolution) + no earlier pass → needs_filter_reground&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="1100" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-erc" value="&lt;b&gt;empty_result_check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (router) · 0-row result only: heuristic (aggregate / GROUP BY / INNER JOIN, no user filter) gates one call → needs_sql_recheck + empty_hint; one pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="1200" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-trc" value="&lt;b&gt;trivial_result_check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · ≤ 1 row and ≤ 5 columns → is_trivial (skip the eval call)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="1300" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-fea" value="&lt;b&gt;fused_eval_analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (primary) · SQL: stats + 12-row sample → answers_intent, summary, insights, follow-ups · ML: analysis_narration, never rejects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="1400" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-rf" value="&lt;b&gt;response_formatter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · pick the answer by terminal state (proposal › analysis_error › analysis › clarification › dlp › route › eval › trivial › error) and build the API contract: sql, results, answer, metrics, routing, status, findings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="420" y="1500" width="520" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-stm" value="&lt;b&gt;save_to_memory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DB · persist SQL, execution status, preview, result artifact and turn artifact (best effort, never fails the answer)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="1590" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-ol" value="&lt;b&gt;observability_log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · emit one QUERY_EVENT structured log (route, retries, tokens, latency, slim node trace)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="1680" width="240" height="64" as="geometry"/>
        </mxCell>

        <!-- ── Left column: memory / routing side nodes + feedback ──────── -->
        <mxCell id="n-hs" value="&lt;b&gt;history_search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DB · &quot;did I ask about X last week?&quot; — search the user's turns on this connection by keyword + time window; deterministic answer, no LLM → answer, history_matches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-cap" value="&lt;b&gt;capability_answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (primary) · explain the assistant and the skill catalog (SKILLS registry); static fallback on failure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-mag" value="&lt;b&gt;memory_answer_generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (router) · one call over ledger + schema/sample of the referenced turns → replay | compute (Postgres SELECT over stored rows as jsonb CTEs) | answer | needs_query; rows recovered cache → snapshot → re-run, on demand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-pdb" value="&lt;b&gt;prior_data_binder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (router) · extract the values a new query needs from a prior result (SELECT over its stored rows) and bind them to a live catalog column as a resolved IN filter → filter_plan, prior_bindings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-cha" value="&lt;b&gt;catalog_help_answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · &quot;which measures / dimensions can I ask about?&quot; — each table's columns as measures / numeric / dimensions / dates from metadata_bundle; governed + sensitive columns hidden; no LLM → answer (Markdown)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-fc" value="&lt;b&gt;feedback_classifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · classify the failure → resolve_filters | empty_recheck (own budgets, retry_count untouched) | missing_table | syntax | exec | semantic | exhausted (retry_count &amp;gt; LANGGRAPH_MAX_RETRIES = 3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="240" height="64" as="geometry"/>
        </mxCell>

        <!-- ── Right column: ML skills branch ───────────────────────────── -->
        <mxCell id="n-ap" value="&lt;b&gt;analysis_planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM (router) · bind the question to a registered skill; fill params from catalog + grounded filters; clarify or fall back to SQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1120" y="500" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-ag" value="&lt;b&gt;analysis_guard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DB · canonicalise identifiers; catalog type guards; 1-row span probe; window fill; history guards; confirm card; hourly limiter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1120" y="600" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-asq" value="&lt;b&gt;analysis_sql&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;logic · deterministic sqlglot aggregate SQL per skill family; limit = row cap + 1; retry_count = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1120" y="700" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n-ar" value="&lt;b&gt;analysis_run&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ML · send aggregate rows (filter values redacted) to AnalysisRunner; row-cap check; audit → analysis_result, headline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1000" width="240" height="64" as="geometry"/>
        </mxCell>

        <!-- ── Arcs: entry and memory ───────────────────────────────────── -->
        <mxCell id="e01" value="default" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n-start" target="n-cc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e02" value="analysis_resume | analysis_confirmed — re-entry from /api/analysis/run (skips memory, router, filters, planner)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;fontColor=#3b6ea5;dashed=1;align=left;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-start" target="n-cl">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="40"/>
              <mxPoint x="840" y="316"/>
            </Array>
            <mxPoint x="8" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e03" value="always — ledger built, no LLM call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n-cc" target="n-fr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e04" value="route == history_lookup (history_query set)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-fr" target="n-hs">
          <mxGeometry x="-0.4" y="-8" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="213"/>
              <mxPoint x="480" y="182"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e05" value="always — matching turns listed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#8a8a8a;dashed=1;fontColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-hs" target="n-rf">
          <mxGeometry x="-0.92" y="-8" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="24" y="182"/>
              <mxPoint x="24" y="1532"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e55" value="memory_action == compute — table computed from stored rows gets narrated like a live result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;align=left;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-mag" target="n-trc">
          <mxGeometry x="0.96" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="408"/>
              <mxPoint x="540" y="1332"/>
            </Array>
            <mxPoint x="-590" y="-30" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e56" value="prior_refs set — bind values from the referenced result first" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-fg" target="n-pdb">
          <mxGeometry y="-8" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="bound (or nothing to bind) → resolved IN filter in filter_plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-pdb" target="n-pb">
          <mxGeometry x="0.35" y="-8" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="632"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e58" value="filter_clarification_required — more than MEMORY_MAX_BOUND_VALUES values, ask to narrow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#8a8a8a;dashed=1;fontColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-pdb" target="n-rf">
          <mxGeometry x="-0.85" y="-8" relative="1" as="geometry">
