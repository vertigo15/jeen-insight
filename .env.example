# ============================================================================
# Jeen Insights — environment template
# ============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored; this template
# is committed to document the full secret/config inventory. NEVER commit real
# secrets. Rotate any credential that has been shared or checked in.
# ============================================================================

# ── Azure OpenAI (default LLM provider) ─────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.1
# Optional cheaper deployment for router/summarizer nodes (defaults to the
# deployment above when blank).
AZURE_OPENAI_ROUTER_DEPLOYMENT=

# ── Shared metadata DB (operational tables + curated metadata) ──────────────
METADATA_DB_HOST=your-db.postgres.database.azure.com
METADATA_DB_PORT=5432
METADATA_DB_NAME=jeen_data_metadata
METADATA_DB_USER=your-db-user
METADATA_DB_PASSWORD=your-db-password
METADATA_DB_SSL=true
# true (default): the API creates/alters its own baseline tables at start-up so
# a fresh local DB just works. Set false wherever the metadata DB is shared with
# a live Schema Modeler: the API then only verifies the baseline exists and all
# schema changes go through scripts/run_insights_migrations.py (the Job).
SCHEMA_BOOTSTRAP_ON_START=true
# Workload pods must never run revisions in a shared deployment. The explicit
# migration Job invokes the runner directly and does not need this set true.
RUN_MIGRATIONS_ON_START=false
# Migration Job safety controls. Keep finite positive lock/statement timeouts;
# checksum drift remains disabled except during an explicitly reviewed recovery.
MIGRATION_LOCK_WAIT_SECONDS=120
MIGRATION_LOCK_TIMEOUT=15s
MIGRATION_STATEMENT_TIMEOUT=10min
MIGRATION_ALLOW_CHECKSUM_DRIFT=false

# ── Application ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Log output format: json (structured, for aggregators), console (human-readable),
# or auto (console when JEEN_DEV_MODE=true, json otherwise).
LOG_FORMAT=auto
# Interface language shown to users who have not picked one yet (and whose
# browser does not ask for a shipped language). BCP 47 tag from the registry in
# src/i18n/__init__.py: en | he. Signed-in users' saved choice always wins.
DEFAULT_LOCALE=en

# ── OpenStreetMap point charts (disabled unless explicitly configured) ───────
# The browser uses a same-origin tile proxy, so API keys never reach client code.
# Use a managed or self-hosted provider rather than public OSM endpoints for
# production workloads. The tile URL must include {z}, {x}, and {y}; it may
# include {api_key}, which is substituted only on the server.
OSM_MAPS_ENABLED=false
OSM_TILE_URL=
OSM_TILE_API_KEY=
OSM_TILE_API_KEY_HEADER=Authorization
OSM_TILE_TIMEOUT_SECONDS=10
# Server + browser tile cache. Raster tiles change rarely; a week avoids
# repeat provider fetches when users pan and zoom the same area.
OSM_TILE_CACHE_TTL_SECONDS=604800
OSM_TILE_CACHE_MAX_ENTRIES=2048
# Optional server-proxied sea-navigation overlay. It must remain enabled only
# when its provider's acceptable-use policy and attribution requirements apply.
OSM_SEAMARKS_ENABLED=false
OSM_SEAMARKS_TILE_URL=https://tiles.openseamap.org/seamark/{z}/{x}/{y}.png
OSM_SEAMARKS_TILE_API_KEY=
OSM_SEAMARKS_TILE_API_KEY_HEADER=Authorization
# Optional MapTiler custom Ocean style. Configure this only after publishing a
# style that renders boundary features filtered to maritime=yes.
OSM_MARITIME_TILE_URL=
OSM_MARITIME_TILE_API_KEY=
OSM_MARITIME_TILE_API_KEY_HEADER=
# Optional Terrain and hillshade-style basemap. The default uses MapTiler's
# Outdoor raster style, but remains off until the deployment validates access.
OSM_TERRAIN_ENABLED=false
OSM_TERRAIN_TILE_URL=https://api.maptiler.com/maps/outdoor/256/{z}/{x}/{y}.png?key={api_key}
OSM_TERRAIN_TILE_API_KEY=
OSM_TERRAIN_TILE_API_KEY_HEADER=
# Configure `nominatim` with a Nominatim-compatible endpoint, or `maptiler`
# with an API key (its default endpoint is used when BASE_URL is blank). Leave
# it blank to allow coordinate data and bundled local city lookups only.
OSM_GEOCODER_PROVIDER=
OSM_GEOCODER_BASE_URL=
OSM_GEOCODER_API_KEY=
OSM_GEOCODER_API_KEY_HEADER=Authorization
OSM_GEOCODER_USER_AGENT=Jeen Insights map geocoder
OSM_GEOCODER_TIMEOUT_SECONDS=5
OSM_GEOCODER_MIN_INTERVAL_SECONDS=1
OSM_GEOCODER_CACHE_TTL_SECONDS=2592000
OSM_GEOCODER_ERROR_CACHE_TTL_SECONDS=300
OSM_GEOCODER_CACHE_MAX_ENTRIES=10000
OSM_GEOCODER_MAX_UNIQUE_PLACES=50

# ── LangGraph agent tuning (optional; sensible defaults in src/config.py) ───
LANGGRAPH_MAX_RETRIES=3
LANGGRAPH_EMPTY_RECHECK=true
DLP_ENABLED=true
DLP_GOVERNED_COLUMNS=
SCHEMA_QUALIFIER_VALIDATION_ENABLED=true
REQUIRE_CATALOG_FOR_QUERY=true

# ── Conversation memory (follow-ups over prior answers and their data) ──────
# Window size is the live runtime setting `conversation_context_turns` (Settings → Runtime).
MEMORY_SAMPLE_ROWS=3
MEMORY_COMPUTE_MAX_ROWS=2000
MEMORY_MAX_BOUND_VALUES=100
HISTORY_LOOKUP_DEFAULT_DAYS=30
HISTORY_LOOKUP_MAX_RESULTS=10
SQLGLOT_VALIDATION_ENABLED=true
EVAL_ANALYTICS_ENABLED=true
LLM_TIMEOUT_SECONDS=30

# ── Runtime guardrails (also live-editable via app_settings) ────────────────
DB_STATEMENT_TIMEOUT_MS=30000
MAX_RESULT_ROWS=10000
CONVERSATION_CONTEXT_TURNS=5

# ── Conversation persistence (restore last conversation on reopen) ──────────
# Requires migration 022 (scripts/run_insights_migrations.py). All retention is
# count-based per user + connection; there is no time-based expiry.
CONVERSATION_PERSISTENCE_ENABLED=true

# ── ML skills (anomaly detection, forecasting) ─────────────────────────────
# Master switch for the needs_analysis route and the /api/analysis endpoints.
# Requires migration 023 (python scripts/run_insights_migrations.py) for the
# confirm card / consent memory; without it skills still run but do not
# remember "don't ask again".
ML_SKILLS_ENABLED=true
# Where skills execute. "sandbox" = the jeen-insights-analytics container (the
# ONLY runner allowed when JEEN_DEV_MODE=false; docker-compose wires it up).
# "local" = a resource-limited child process inside the API — development only.
ANALYSIS_RUNNER=local
ANALYSIS_SANDBOX_URL=http://jeen-insights-analytics:8100
ANALYSIS_SANDBOX_AUDIENCE=jeen-insights-analytics
# Reject unsigned API-to-sandbox calls. Keep enabled outside isolated tests.
ANALYSIS_AUTH_ENABLED=true
# Signs/verifies sandbox-audience tokens. Set the SAME value in the API and the
# sandbox; keep it distinct from INTERNAL_API_SECRET so the sandbox can never
# sign an API token. Blank = fall back to the shared secret (dev only).
INTERNAL_ANALYTICS_SECRET=
# Hard limits: wall clock per run, memory cap for the run, rows sent to the
# model (tier A aggregates / tier B row-level), and the per-user hourly budget.
ANALYSIS_TIMEOUT_SECONDS=60
ANALYSIS_MEMORY_MB=1024
ANALYSIS_MAX_SERIES_ROWS=1500
ANALYSIS_MAX_ENTITY_ROWS=50000
ANALYSIS_MAX_CONCURRENT=2
ANALYSIS_RUNS_PER_HOUR_PER_USER=60
# How long a confirm / clarify / guard card stays resumable.
ANALYSIS_PROPOSAL_TTL_SECONDS=900
CONVERSATION_SNAPSHOT_MAX_ROWS=2000
CONVERSATION_SNAPSHOT_MAX_BYTES=1048576
CONVERSATION_CHART_MAX_BYTES=524288
CONVERSATION_KEEP_LAST=30
CONVERSATION_SNAPSHOT_KEEP_LAST_TURNS=100
CONVERSATION_RETENTION_ON_OPEN=true
CONVERSATION_RETENTION_MIN_INTERVAL_SECONDS=600
CONVERSATION_MAX_TURNS_HYDRATED=50

# ── Per-user result cache (optional) ────────────────────────────────────────
JEEN_RESULT_CACHE_MAX_ENTRIES=256
JEEN_RESULT_CACHE_TTL_SECONDS=1800
JEEN_RESULT_CACHE_PER_USER=5

# ── Deployment mode ─────────────────────────────────────────────────────────
# POC / portable mode is the DEFAULT (JEEN_DEV_MODE unset or true). In this mode
# the app "just works" anywhere with zero secret provisioning: it boots without a
# strong FLASK_SECRET_KEY / INTERNAL_API_SECRET (UI + API fall back to a shared
# built-in dev secret so they agree), and it stores the MCP catalog bearer token
# as PLAINTEXT so the same shared metadata DB stays readable by every copy of the
# app (local / any Azure or k8s stack). Copy the DB + app to a new stack and it
# works without extra config.
#
# HARDEN a real deployment by setting JEEN_DEV_MODE=false: the app then REFUSES to
# start with a missing/known FLASK_SECRET_KEY or INTERNAL_API_SECRET, defaults
# SESSION_COOKIE_SECURE to true, and requires a valid APP_ENCRYPTION_KEY before it
# will store an MCP bearer token (encrypted at rest).
JEEN_DEV_MODE=true

# ── Flask UI: session + security ────────────────────────────────────────────
# Signing key for the session cookie AND (by fallback) the internal API token.
# REQUIRED in production: the app refuses to start with a missing/known key
# unless JEEN_DEV_MODE=true. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me-generate-a-random-48+-char-value
# Send session/CSRF cookies over HTTPS only. Defaults to true in production and
# false in dev mode. Keep false only for local HTTP dev behind no TLS.
SESSION_COOKIE_SECURE=false
# First-run admin bootstrap token. Required to complete the /setup screen. When
# blank a random token is generated once and printed to the server log so only
# an operator (with log access) can create the first admin. Pin your own here to
# script/automate bootstrap:
SETUP_BOOTSTRAP_TOKEN=
# Login rate-limit storage. Default in-memory suits a single UI process; use a
# shared store (e.g. redis://host:6379) for multi-worker/multi-instance deploys.
RATELIMIT_STORAGE_URI=memory://

# ── Flask UI ↔ API wiring (set by docker-compose for the UI container) ──────
API_BASE_URL=http://jeen-insights-api:8000
UI_PORT=8501
# Public URL of the UI, used to build the OAuth redirect behind proxies.
PUBLIC_APP_URL=http://localhost:8501

# ── Microsoft Entra ID (Azure AD) SSO — optional ────────────────────────────
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Explicit OAuth redirect URI (optional; derived from PUBLIC_APP_URL when blank).
AZURE_AD_REDIRECT_URI=

# ── Generic OpenID Connect sign-in (Keycloak, Zitadel, ...) ─────────────────
# A provider <P> is enabled when OIDC_<P>_ISSUER and OIDC_<P>_CLIENT_ID are set
# (providers: OIDC_PROVIDERS, default "keycloak,zitadel"). Redirect URI is
# <PUBLIC_APP_URL>/auth/<p>/callback. PKCE is always used; a CLIENT_SECRET makes
# the client confidential. IDP_HINT is Keycloak's kc_idp_hint (e.g. entra-id).
# ADMIN_ROLES / EDITOR_ROLES (comma lists) make the provider authoritative for
# the application role; leave both blank to keep roles managed in Settings.
OIDC_PROVIDERS=keycloak,zitadel
OIDC_KEYCLOAK_ISSUER=
OIDC_KEYCLOAK_CLIENT_ID=
OIDC_KEYCLOAK_CLIENT_SECRET=
OIDC_KEYCLOAK_LABEL=Keycloak
OIDC_KEYCLOAK_SCOPES=openid profile email
OIDC_KEYCLOAK_IDP_HINT=
OIDC_KEYCLOAK_ADMIN_ROLES=
OIDC_KEYCLOAK_EDITOR_ROLES=
OIDC_ZITADEL_ISSUER=
OIDC_ZITADEL_CLIENT_ID=
OIDC_ZITADEL_CLIENT_SECRET=
OIDC_ZITADEL_LABEL=Zitadel
OIDC_ZITADEL_SCOPES=openid profile email
OIDC_ZITADEL_IDP_HINT=
OIDC_ZITADEL_ADMIN_ROLES=
OIDC_ZITADEL_EDITOR_ROLES=
# Extra PEM bundle trusted for the providers' TLS (private CA); OIDC_TLS_VERIFY=false
# disables verification — development only.
OIDC_CA_BUNDLE=
OIDC_TLS_VERIFY=true

# ── Connector / integration platform (per-user MCP-style connectors) ────────
# The feature ships DARK: an admin must flip the master switch on the
# Settings → Integrations page (persisted in app_settings.connectors_enabled).
#
# Internal auth boundary: Flask mints short-lived audience-bound tokens that
# FastAPI verifies into a Principal. Leave blank to reuse FLASK_SECRET_KEY /
# AUTH_SECRET (both containers share .env so the secret matches). To rotate,
# set "<kid>:<secret>[,<kid>:<secret>...]" — the first entry signs, all verify.
INTERNAL_API_SECRET=
# Default-deny: FastAPI rejects any non-exempt request lacking a valid internal
# token. Keep true in every real deployment.
INTERNAL_AUTH_ENABLED=true
# Master key (KEK) for envelope-encrypting connector client secrets, per-user
# OAuth tokens, and the MCP catalog bearer token. OPTIONAL in POC mode
# (JEEN_DEV_MODE=true): when unset, secrets are stored in portable plaintext so
# the shared DB works across stacks. REQUIRED when JEEN_DEV_MODE=false — the
# connector feature and MCP-token storage then fail closed without it. Generate a
# 32-byte base64 key with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# BACK THIS UP: losing it makes all stored connector secrets unrecoverable. Note
# a KEK-encrypted token is only readable by stacks that share this exact key.
# Rotate with "<kid>:<key>[,<kid>:<key>...]" (first wraps new data, all unwrap).
APP_ENCRYPTION_KEY=
# One-time backfill that encrypts the catalog MCP bearer token at rest. This
# rewrites a row in the SHARED metadata DB in-place and nulls its plaintext
# column, so it is OPT-IN: only enable it once EVERY deployment reading this DB
# shares the same APP_ENCRYPTION_KEY, otherwise the other readers can no longer
# decrypt the token and the catalog silently goes empty. Leave unset/false for
# routine migration runs from developer machines.
ENCRYPT_MCP_TOKENS_BACKFILL=false
# Single-tenant deployment tenant id for connector identities/groups. Falls back
# to AZURE_AD_TENANT_ID when blank.
CONNECTORS_TENANT_ID=
# Default outbound recipient domain allowlist (comma-separated). Blank = each
# sender may only email their own domain. Per-connector policy overrides this.
CONNECTOR_RECIPIENT_DOMAIN_ALLOWLIST=
# TTL (seconds) for durable result snapshots and pending action proposals.
CONNECTOR_SNAPSHOT_TTL_SECONDS=3600
CONNECTOR_PROPOSAL_TTL_SECONDS=900
# Max age (seconds) a cached Entra group-membership snapshot is trusted for
# authorization. After this the entitlement check treats the cache as stale and
# fails closed, so removing a user from a group revokes access within the window.
CONNECTOR_GROUP_MEMBERSHIP_TTL_SECONDS=900

# ── Legacy / unused (kept for backward compatibility; safe to omit) ─────────
# AUTH_SECRET is an older alias for FLASK_SECRET_KEY (still honored as fallback).
AUTH_SECRET=
# AUTH_URL / AUTH_TRUST_HOST are leftovers from a previous Auth.js setup and are
# not read by the current Flask code.
AUTH_URL=
AUTH_TRUST_HOST=
